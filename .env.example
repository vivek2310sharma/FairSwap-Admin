# Placeholder-only foundation settings. No credentials are required or included.
# Empty values keep the foundation unconfigured and staff workflows disabled.
# The only allowed deployment environment is test, independent of NODE_ENV.
FAIRSWAP_DEPLOYMENT_ENV=
# Only the exact FairSwapTest HTTPS origin is accepted by validation.
FAIRSWAP_SUPABASE_URL=
# Non-elevated publishable key only (sb_publishable_ format).
# Leave empty for credential-free builds/tests. Never use a secret/service-role key.
FAIRSWAP_SUPABASE_PUBLISHABLE_KEY=
