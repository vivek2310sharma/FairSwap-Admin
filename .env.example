# Placeholder-only server settings. Never commit real values or use NEXT_PUBLIC_.
# Exact environment: test or production; NODE_ENV does not select the backend.
FAIRSWAP_DEPLOYMENT_ENV=
# Exact HTTPS origin matching the selected project; see docs/runbooks/production-release.md.
FAIRSWAP_SUPABASE_URL=
# Existing matching non-elevated modern publishable key. Syntax alone does not prove project identity.
FAIRSWAP_SUPABASE_PUBLISHABLE_KEY=
# Optional for Test; required active for an approved Production launch.
# maintenance disables clients/auth/actions without selecting another backend.
FAIRSWAP_ADMIN_RELEASE_STATE=
# Optional loopback Test diagnostics; never enabled in Production or hosting.
FAIRSWAP_AUTH_DIAGNOSTICS=
